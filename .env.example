# ==============================================
# x-llamaindex Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values

# --------------------------------------------
# LLM Provider Configuration
# --------------------------------------------
# Supported providers: deepseek (default), kimi, glm
LLM_PROVIDER=deepseek
TEMPERATURE=0.1

# DeepSeek Configuration (默认)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Kimi (Moonshot) Configuration
# KIMI_API_KEY=sk-your-kimi-api-key-here
# KIMI_API_BASE=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k

# GLM (智谱) Configuration
# GLM_API_KEY=your-glm-api-key-here
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-flash

# --------------------------------------------
# Embedding Model Configuration
# --------------------------------------------
# 支持 DeepSeek 和本地嵌入模型
EMBEDDING_PROVIDER=deepseek
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# DeepSeek Embedding
DEEPSEEK_EMBEDDING_MODEL=text-embedding-ada-002

# --------------------------------------------
# Vector Store Configuration
# --------------------------------------------
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION_NAME=llamaindex_docs

# --------------------------------------------
# Server Configuration
# --------------------------------------------
DEBUG=true
PORT=8000
HOST=0.0.0.0

# --------------------------------------------
# RAG Configuration
# --------------------------------------------
# Chunk size for document splitting
CHUNK_SIZE=512
# Overlap between chunks
CHUNK_OVERLAP=50
# Number of top-k results to retrieve
SIMILARITY_TOP_K=5
# Minimum similarity score threshold
SIMILARITY_THRESHOLD=0.5

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/rag_app.log
