# ==============================================
# x-llamaindex YAML Configuration
# ==============================================
# Copy this file to config.yaml and customize

# Server settings
server:
  debug: true
  port: 8000
  host: "0.0.0.0"
  cors_origins:
    - "http://localhost:3000"
    - "http://127.0.0.1:3000"

# Logging settings
logging:
  level: "INFO"
  file_path: "logs/rag_app.log"
  rotation: "1 day"
  retention: "7 days"

# LLM settings
llm:
  provider: "openai"
  model: "gpt-3.5-turbo"
  temperature: 0.1
  max_tokens: 2048
  timeout: 60

# Embedding settings
embedding:
  model: "text-embedding-ada-002"
  dimension: 1536
  batch_size: 100

# Vector store settings
vector_store:
  type: "chroma"
  persist_dir: "./storage/chroma"
  collection_name: "llamaindex_docs"

# Document processing settings
document:
  # Chunking strategy: sentence, paragraph, semantic
  chunking_strategy: "sentence"
  chunk_size: 512
  chunk_overlap: 50
  # Supported file extensions
  supported_extensions:
    - ".txt"
    - ".pdf"
    - ".docx"
    - ".md"
    - ".json"

# Retrieval settings
retrieval:
  similarity_top_k: 5
  similarity_threshold: 0.5
  # Enable reranking
  rerank_enabled: false
  rerank_model: "cross-encoder"

# Agent settings
agent:
  main_agent:
    max_iterations: 50
    timeout: 300
    verbose: true
  subagents:
    researcher:
      max_results: 10
      timeout: 120
    analyst:
      timeout: 180
    writer:
      timeout: 240

# RAG application settings
rag:
  data_dir: "./data"
  output_dir: "./reports"
  templates_dir: "./templates"
  max_sources: 20
  default_topic: "general"

# Evaluation settings
evaluation:
  enabled: false
  metrics:
    - "faithfulness"
    - "relevancy"
    - "context_similarity"
